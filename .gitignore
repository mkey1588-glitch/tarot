# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Phase 0 stores users in JSON files. Real birth data is personal
# information under 個人情報保護法. It does not go in git.
data/
*.jsonl

# Source material we read from but do not carry. Git history is permanent
# and this repository will outlive any one person's control of it.
#
# The board package v1.1 in particular contains claims later established to
# be wrong, corrected only in Appendix I. Committed here without that
# appendix attached, someone finds it in two years and treats it as fact.
#
# Tracked documentation is CLAUDE.md, README.md and docs/*.md. Nothing else.
reference/
docs/*.pdf
docs/*.docx

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# OS / editor
.DS_Store
.idea/
.vscode/
