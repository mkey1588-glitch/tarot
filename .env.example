# Copy to .env and fill in. .env is gitignored — keep it that way.

# ===== LINE Messaging API (https://developers.line.biz/console/) =====
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ===== LLM =====
OPENAI_API_KEY=
# Cheap model for free daily content; stronger model for paid readings.
LLM_MODEL_FREE=gpt-4o-mini
LLM_MODEL_PAID=gpt-4o

# ===== Phase 0 business parameters =====
# Free readings per user per day
FREE_TIER_LIMIT=3
# Single deep reading price, JPY. Phase 0 tests willingness to pay;
# Phase 1 replaces this with the ¥980/month subscription.
DEEP_READING_PRICE_JPY=300

# ===== Payments (Phase 0: Stripe Japan checkout, ~3.6%) =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== Ops =====
PORT=8000
LOG_LEVEL=INFO
# Cap spend so a bug cannot empty the budget. Phase 0 total is $1-3K.
MONTHLY_LLM_BUDGET_USD=50
# Gates /admin/stats and /admin/review-queue. The review queue contains
# birth data — personal information under 個人情報保護法 — so leaving this
# unset disables those endpoints rather than serving them to anyone.
ADMIN_TOKEN=
# Where a boundary-chart alert is pushed. A chart on a solar-term boundary
# is not answered automatically — the user is told a person will look, and
# that promise should not depend on someone remembering to open
# /admin/review-queue. Unset means log-only, which /admin/stats reports as
# unconfigured rather than letting it look solved.
OPERATOR_LINE_USER_ID=
